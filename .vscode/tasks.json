{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "cmake",
      "command": "configure",
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "gardeners"
      ],
      "dependsOn": "CMake: configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CMake: test",
      "type": "cmake",
      "command": "test",
      "dependsOn": "CMake: build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: run demo",
      "type": "cmake",
      "command": "build",
      "targets": [
        "run"
      ],
      "dependsOn": "CMake: build",
      "problemMatcher": []
    }
  ]
}
