{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Садовники: CMake / GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake-debug/IDZ/IDZ1/gardeners",
      "args": [
        "data/demo.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/IDZ/IDZ1",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "ИДЗ2: семафоры",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake-debug/IDZ/IDZ2/gardeners",
      "args": ["data/demo.txt"],
      "cwd": "${workspaceFolder}/IDZ/IDZ2",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "preLaunchTask": "CMake: build IDZ2"
    },
    {
      "name": "ИДЗ2: условные переменные",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake-debug/IDZ/IDZ2/gardeners_cond",
      "args": ["data/demo.txt"],
      "cwd": "${workspaceFolder}/IDZ/IDZ2",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "preLaunchTask": "CMake: build IDZ2"
    },
    {
      "name": "ИДЗ3: именованные семафоры",
      "type": "cppdbg", "request": "launch",
      "program": "${workspaceFolder}/build/cmake-debug/IDZ/IDZ3/gardeners_named",
      "args": ["data/demo.txt"], "cwd": "${workspaceFolder}/IDZ/IDZ3",
      "MIMode": "gdb", "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false, "preLaunchTask": "CMake: build"
    },
    {
      "name": "ИДЗ3: неименованные семафоры",
      "type": "cppdbg", "request": "launch",
      "program": "${workspaceFolder}/build/cmake-debug/IDZ/IDZ3/gardeners_unnamed",
      "args": ["data/demo.txt"], "cwd": "${workspaceFolder}/IDZ/IDZ3",
      "MIMode": "gdb", "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false, "preLaunchTask": "CMake: build"
    }
  ]
}
